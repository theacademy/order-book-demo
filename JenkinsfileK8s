pipeline {
    agent any

    environment {
        // AWS Configuration
        AWS_REGION = 'eu-central-1'
        EKS_CLUSTER_NAME = 'test-cluster-2'
        AWS_ACCOUNT_ID = '271758791556'
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPOSITORY = 'orderbook-tomcat'
        APP_NAME = 'orderbook'
        NAMESPACE = 'qa'
        APP_PORT = '8085'

        // Monitoring Configuration
        PROMETHEUS_NAMESPACE = 'prometheus'
        GRAFANA_NAMESPACE = 'grafana'

        // SonarQube Configuration
        SONAR_HOST_URL = 'http://13.51.106.82:9000'
        SONAR_PROJECT_KEY = 'order-book-demo'
        SONAR_PROJECT_NAME = 'Orderbook Demo Application'

        // Quality Gates
        MIN_COVERAGE = '70'
    }

    tools {
        maven 'MAVEN_HOME'
        jdk 'JAVA_HOME'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/theacademy/order-book-demo.git'
                script {
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    echo "Git commit: ${env.GIT_COMMIT_SHORT}"
                }
            }
        }

        stage('Build & Test') {
            parallel {
                stage('Compile') {
                    steps {
                        sh 'mvn compile'
                    }
                }

                stage('Code Review') {
                    steps {
                        sh 'mvn pmd:pmd'
                    }
                    post {
                        success {
                            recordIssues enabledForFailure: true, tool: pmdParser(pattern: '**/target/pmd.xml')
                        }
                    }
                }

                stage('Test with Coverage') {
                    steps {
                        sh 'mvn clean test jacoco:report -Pcoverage'
                    }
                }
            }
        }

        stage('Publish Test & Coverage Reports') {
            steps {
                junit 'target/surefire-reports/*.xml'
                recordCoverage(
                    tools: [[
                        parser: 'JACOCO',
                        pattern: 'target/site/jacoco/jacoco.xml'
                    ]],
                    sourceCodeRetention: 'MODIFIED'
                )
                archiveArtifacts artifacts: 'target/site/jacoco/**', fingerprint: true
                echo "JaCoCo HTML report archived in build artifacts"
            }
        }

        // ============================================
        // SonarQube Analysis Stage with Polling
        // ============================================
        stage('SonarQube Analysis') {
            steps {
                script {
                    // Run SonarQube analysis
                    withSonarQubeEnv('SonarQube') {
                        sh """
                            mvn sonar:sonar \\
                                -Dsonar.host.url=${SONAR_HOST_URL} \\
                                -Dsonar.projectKey=${SONAR_PROJECT_KEY} \\
                                -Dsonar.projectName='${SONAR_PROJECT_NAME}' \\
                                -Dsonar.java.binaries=target/classes \\
                                -Dsonar.java.test.binaries=target/test-classes \\
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \\
                                -Dsonar.junit.reportPaths=target/surefire-reports \\
                                -Dsonar.java.pmd.reportPaths=target/pmd.xml \\
                                -Dsonar.sourceEncoding=UTF-8
                        """
                    }

                    echo "SonarQube analysis submitted. Waiting for processing..."
                }
            }
        }

        // ============================================
        // SonarQube Quality Gate with Polling
        // ============================================
        stage('SonarQube Quality Gate') {
            steps {
                script {
                    def maxAttempts = 30
                    def attempts = 0
                    def qualityGateStatus = "PENDING"

                    echo "Waiting for SonarQube to process the analysis..."

                    while (qualityGateStatus == "PENDING" && attempts < maxAttempts) {
                        sleep(time: 10, unit: 'SECONDS')
                        attempts++

                        echo "Attempt ${attempts}/${maxAttempts}: Checking quality gate..."

                        // Check quality gate status
                        def response = sh(
                            script: "curl -s 'http://13.51.106.82:9000/api/qualitygates/project_status?projectKey=${SONAR_PROJECT_KEY}' 2>/dev/null",
                            returnStdout: true
                        ).trim()

                        if (response.contains('"status":"OK"')) {
                            qualityGateStatus = "OK"
                            echo "Quality Gate: PASSED"
                        } else if (response.contains('"status":"ERROR"')) {
                            qualityGateStatus = "ERROR"
                            echo " Quality Gate: FAILED"

                            // Extract failed conditions
                            def conditions = sh(
                                script: "curl -s 'http://13.51.106.82:9000/api/qualitygates/project_status?projectKey=${SONAR_PROJECT_KEY}' | python3 -c \"import sys, json; data=json.load(sys.stdin); conditions = data.get('projectStatus', {}).get('conditions', []); [print(f\\\"  - {c.get('metricKey')}: {c.get('actualValue')} (threshold: {c.get('errorThreshold')})\\\") for c in conditions if c.get('status') == 'ERROR']\" 2>/dev/null",
                                returnStdout: true
                            )
                            if (conditions.trim()) {
                                echo "Failed conditions:"
                                echo conditions
                            }
                        } else if (response.contains('"status":"PENDING"') || response.contains('"status":"NONE"')) {
                            qualityGateStatus = "PENDING"
                            echo "Still processing... waiting"
                        } else if (response.isEmpty()) {
                            echo "  Waiting for analysis to start..."
                        } else {
                            echo "Response: ${response.substring(0, Math.min(200, response.length()))}"
                        }
                    }

                    if (attempts >= maxAttempts) {
                        echo "Timeout waiting for quality gate (${maxAttempts * 10} seconds)"
                        echo "Continuing pipeline, but please check SonarQube dashboard manually"
                    } else if (qualityGateStatus == "ERROR") {
                        error "Quality Gate failed! Please check SonarQube dashboard for details."
                    } else if (qualityGateStatus == "OK") {
                        echo "Quality Gate passed successfully!"
                    }
                }
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }

        stage('Docker Build & Push') {
            steps {
                withAWS(credentials: 'aws-credentials', region: "${AWS_REGION}") {
                    script {
                        def imageTag = "${BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"
                        sh """
                            # Login to ECR
                            aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}

                            # Build Docker image
                            docker build --build-arg JAR_FILE=target/orderbook.war \\
                                        -t ${ECR_REGISTRY}/${ECR_REPOSITORY}:${imageTag} \\
                                        -t ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest .

                            # Push images to ECR
                            docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:${imageTag}
                            docker push ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest
                        """
                    }
                }
            }
        }

        stage('Deploy to EKS') {
            steps {
                withAWS(credentials: 'aws-credentials', region: "${AWS_REGION}") {
                    script {
                        def imageTag = "${BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}"
                        sh """#!/bin/bash
                            set -e

                            echo "Deploying to EKS cluster: ${EKS_CLUSTER_NAME}"

                            # Configure kubectl for new cluster
                            aws eks update-kubeconfig --region ${AWS_REGION} --name ${EKS_CLUSTER_NAME}

                            # Create namespace if not exists
                            kubectl create namespace ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

                            # Create ECR pull secret
                            echo "Creating ECR pull secret..."
                            kubectl delete secret ecr-pull-secret -n ${NAMESPACE} --ignore-not-found
                            ECR_PASSWORD=\$(aws ecr get-login-password --region ${AWS_REGION})
                            kubectl create secret docker-registry ecr-pull-secret \\
                                --docker-server=${ECR_REGISTRY} \\
                                --docker-username=AWS \\
                                --docker-password="\${ECR_PASSWORD}" \\
                                --namespace ${NAMESPACE}

                            # Create ServiceMonitor for Prometheus
                            echo "Creating ServiceMonitor for Prometheus..."
                            cat > /tmp/servicemonitor.yaml << 'EOF'
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: ${APP_NAME}
  namespace: ${PROMETHEUS_NAMESPACE}
  labels:
    app: ${APP_NAME}
    release: prometheus
spec:
  selector:
    matchLabels:
      app: ${APP_NAME}
  endpoints:
  - port: metrics
    path: /actuator/prometheus
    interval: 30s
    scrapeTimeout: 10s
  namespaceSelector:
    matchNames:
    - ${NAMESPACE}
EOF

                            kubectl apply -f /tmp/servicemonitor.yaml || echo "ServiceMonitor may require CRDs installed"

                            # Create deployment and service
                            echo "Creating deployment configuration..."
                            cat > /tmp/deployment.yaml << 'EOF'
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${APP_NAME}
  namespace: ${NAMESPACE}
  labels:
    app: ${APP_NAME}
    version: ${imageTag}
    monitored-by: prometheus
spec:
  replicas: 2
  selector:
    matchLabels:
      app: ${APP_NAME}
  template:
    metadata:
      labels:
        app: ${APP_NAME}
        version: ${imageTag}
        monitored-by: prometheus
      annotations:
        prometheus.io/scrape: "true"
        prometheus.io/port: "${APP_PORT}"
        prometheus.io/path: "/actuator/prometheus"
    spec:
      imagePullSecrets:
      - name: ecr-pull-secret
      containers:
      - name: ${APP_NAME}
        image: ${ECR_REGISTRY}/${ECR_REPOSITORY}:${imageTag}
        imagePullPolicy: Always
        ports:
        - containerPort: ${APP_PORT}
          name: http
        - containerPort: ${APP_PORT}
          name: metrics
        env:
        - name: MANAGEMENT_METRICS_TAGS_APPLICATION
          value: "${APP_NAME}"
        - name: MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE
          value: "prometheus,health,info,metrics"
        - name: BUILD_NUMBER
          value: "${imageTag}"
        - name: SPRING_PROFILES_ACTIVE
          value: "production"
        - name: SERVER_PORT
          value: "${APP_PORT}"
        - name: JAVA_OPTS
          value: "-Xmx256m -Xms128m"
        resources:
          requests:
            memory: "256Mi"
            cpu: "100m"
          limits:
            memory: "512Mi"
            cpu: "300m"
        livenessProbe:
          httpGet:
            path: /actuator/health
            port: ${APP_PORT}
          initialDelaySeconds: 120
          periodSeconds: 20
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /actuator/health
            port: ${APP_PORT}
          initialDelaySeconds: 60
          periodSeconds: 15
          failureThreshold: 3
        startupProbe:
          httpGet:
            path: /actuator/health
            port: ${APP_PORT}
          initialDelaySeconds: 40
          periodSeconds: 20
          failureThreshold: 12
---
apiVersion: v1
kind: Service
metadata:
  name: ${APP_NAME}
  namespace: ${NAMESPACE}
  labels:
    app: ${APP_NAME}
    monitored-by: prometheus
  annotations:
    prometheus.io/scrape: "true"
    prometheus.io/port: "${APP_PORT}"
    prometheus.io/path: "/actuator/prometheus"
spec:
  selector:
    app: ${APP_NAME}
  type: LoadBalancer
  ports:
  - name: http
    port: 80
    targetPort: ${APP_PORT}
    protocol: TCP
  - name: metrics
    port: ${APP_PORT}
    targetPort: ${APP_PORT}
    protocol: TCP
EOF

                            # Apply the deployment
                            echo "Applying Kubernetes manifests..."
                            kubectl apply -f /tmp/deployment.yaml

                            # Wait for rollout
                            echo "⏳ Waiting for deployment to roll out..."
                            kubectl rollout status deployment/${APP_NAME} -n ${NAMESPACE} --timeout=5m

                            # Get service information
                            echo "Deployment successful!"
                            echo "Service information:"
                            kubectl get svc -n ${NAMESPACE} ${APP_NAME}
                        """
                    }
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                withAWS(credentials: 'aws-credentials', region: "${AWS_REGION}") {
                    script {
                        sh """#!/bin/bash
                            echo "Verifying deployment..."

                            # Check pod status
                            echo "Pod Status:"
                            kubectl get pods -n ${NAMESPACE} -l app=${APP_NAME}

                            # Check service
                            echo -e "\nService Details:"
                            kubectl get svc -n ${NAMESPACE} ${APP_NAME}

                            # Check if metrics endpoint is accessible
                            echo -e "\nChecking metrics endpoint..."
                            POD_NAME=\$(kubectl get pods -n ${NAMESPACE} -l app=${APP_NAME} -o jsonpath='{.items[0].metadata.name}')
                            if [ -n "\$POD_NAME" ]; then
                                kubectl exec -n ${NAMESPACE} \$POD_NAME -- curl -s http://localhost:${APP_PORT}/actuator/prometheus | head -5
                            fi

                            # Check if all pods are ready
                            READY_PODS=\$(kubectl get pods -n ${NAMESPACE} -l app=${APP_NAME} --field-selector status.phase=Running | grep -v NAME | wc -l)
                            TOTAL_PODS=\$(kubectl get pods -n ${NAMESPACE} -l app=${APP_NAME} --no-headers | wc -l)

                            if [ "\$READY_PODS" -eq "\$TOTAL_PODS" ] && [ "\$TOTAL_PODS" -gt 0 ]; then
                                echo "All \$TOTAL_PODS pods are running!"
                                exit 0
                            else
                                echo "Only \$READY_PODS/\$TOTAL_PODS pods are ready"
                                echo "Recent pod events:"
                                kubectl describe pods -n ${NAMESPACE} -l app=${APP_NAME} | grep -A10 Events
                                exit 1
                            fi
                        """
                    }
                }
            }
        }

        stage('Verify Prometheus Integration') {
            steps {
                withAWS(credentials: 'aws-credentials', region: "${AWS_REGION}") {
                    script {
                        sh """#!/bin/bash
                            echo "Verifying Prometheus integration..."

                            # Check if ServiceMonitor exists
                            if kubectl get servicemonitor -n ${PROMETHEUS_NAMESPACE} ${APP_NAME} &>/dev/null; then
                                echo "ServiceMonitor found"
                            else
                                echo "ServiceMonitor not found (may require Prometheus Operator CRDs)"
                            fi

                            # Query Prometheus for application metrics
                            PROM_URL=\$(kubectl get svc -n ${PROMETHEUS_NAMESPACE} prometheus-server -o jsonpath='{.status.loadBalancer.ingress[0].hostname}')
                            if [ -n "\$PROM_URL" ]; then
                                echo "Checking if metrics are being scraped..."
                                curl -s "http://\$PROM_URL/api/v1/query?query=up{app='${APP_NAME}'}" | head -10
                            fi
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                withAWS(credentials: 'aws-credentials', region: "${AWS_REGION}") {
                    // Get all URLs dynamically
                    def LB_URL = sh(
                        script: "kubectl get svc -n ${NAMESPACE} ${APP_NAME} -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || echo 'Provisioning'",
                        returnStdout: true
                    ).trim()

                    def GRAFANA_URL = sh(
                        script: "kubectl get svc -n ${GRAFANA_NAMESPACE} grafana -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || echo 'Not available'",
                        returnStdout: true
                    ).trim()

                    def PROM_URL = sh(
                        script: "kubectl get svc -n ${PROMETHEUS_NAMESPACE} prometheus-server -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || echo 'Not available'",
                        returnStdout: true
                    ).trim()

                    def GRAFANA_PASS = sh(
                        script: "kubectl get secret -n ${GRAFANA_NAMESPACE} grafana -o jsonpath='{.data.admin-password}' 2>/dev/null | base64 --decode",
                        returnStdout: true
                    ).trim()

                    def SONAR_PROJECT_URL = "${SONAR_HOST_URL}/dashboard?id=${SONAR_PROJECT_KEY}"
                    def BUILD_URL_FULL = env.BUILD_URL ?: "http://16.16.201.50:8080/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/"
                    def COVERAGE_URL = "${BUILD_URL_FULL}artifact/target/site/jacoco/index.html"

                    // Print success message with actual values
                    echo """
**DEPLOYMENT SUCCESSFUL**
=================================
Application: ${APP_NAME}
Version: ${BUILD_NUMBER}-${env.GIT_COMMIT_SHORT}
Namespace: ${NAMESPACE}
Cluster: ${EKS_CLUSTER_NAME}
Region: ${AWS_REGION}

**Application URL:** http://${LB_URL}/api/v1/
**Health Check:** http://${LB_URL}/actuator/health
**Prometheus Metrics:** http://${LB_URL}/actuator/prometheus

**Monitoring:**
- Prometheus: http://${PROM_URL}
- Grafana: http://${GRAFANA_URL}
  Username: admin
  Password: ${GRAFANA_PASS}

**Code Quality (SonarQube):**
- Dashboard: ${SONAR_PROJECT_URL}

**Jenkins Build:** ${BUILD_URL_FULL}
**JaCoCo Coverage:** ${COVERAGE_URL}
=================================
"""
                }
            }
        }

        failure {
            script {
                withAWS(credentials: 'aws-credentials', region: "${AWS_REGION}") {
                    echo "Pipeline failed! Gathering diagnostics..."

                    sh """#!/bin/bash
                        echo "**DIAGNOSTIC INFORMATION**"
                        echo "================================"
                        echo "Cluster: ${EKS_CLUSTER_NAME}"
                        echo "Namespace: ${NAMESPACE}"
                        echo ""

                        # Check cluster connectivity
                        echo "Cluster Info:"
                        kubectl cluster-info 2>&1 || echo "Unable to connect to cluster"

                        # Check if namespace exists
                        if kubectl get namespace ${NAMESPACE} &>/dev/null; then
                            echo "Pod Status in ${NAMESPACE}:"
                            kubectl get pods -n ${NAMESPACE}

                            echo -e "\nRecent Pod Events:"
                            kubectl describe pods -n ${NAMESPACE} | grep -A20 Events || echo "No events"

                            echo -e "\nRecent Logs:"
                            for pod in \$(kubectl get pods -n ${NAMESPACE} -o name | head -2); do
                                echo "--- \$pod ---"
                                kubectl logs \$pod -n ${NAMESPACE} --tail=50 || echo "No logs"
                            done

                            echo -e "\n⚙️ Deployment Status:"
                            kubectl describe deployment ${APP_NAME} -n ${NAMESPACE} || echo "Deployment not found"
                        else
                            echo "Namespace ${NAMESPACE} does not exist"
                        fi

                        echo -e "\nRecent Images in ECR:"
                        aws ecr describe-images --repository-name ${ECR_REPOSITORY} --region ${AWS_REGION} \\
                            --query 'imageDetails[*].{Tags:imageTags, PushedAt:imagePushedAt}' \\
                            --output table | head -20

                        echo "================================"
                    """
                }
            }
        }

        always {
            junit 'target/surefire-reports/*.xml'
            archiveArtifacts artifacts: 'target/site/jacoco/**', fingerprint: true
            echo "Cleaning up workspace..."
            cleanWs()
        }
    }
}