pipeline {
    agent any
     environment {
          ANSIBLE_HOST_KEY_CHECKING = "False"
          DOCKER_CREDS = credentials('DOCKER_HUB_LOGIN')
     }
    tools { 
      maven 'MAVEN_HOME' 
      jdk 'JAVA_HOME' 
    }
    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/theacademy/order-book-demo'
            }
        }

        stage('Build & Test') {
                    parallel {
                        stage('Compile') {
                            steps {
                                sh 'mvn compile'
                            }
                        }

                        stage('Code Review') {
                            steps {
                                sh 'mvn pmd:pmd'
                            }
                            post {
                                success {
                                    recordIssues enabledForFailure: true, tool: pmdParser(pattern: '**/target/pmd.xml')
                                }
                            }
                        }

                        stage('Test with Coverage') {
                            steps {
                                sh 'mvn clean test jacoco:report -Pcoverage'
                            }
                        }
                    }
                }

                stage('Publish Test & Coverage Reports') {
                    steps {
                        junit 'target/surefire-reports/*.xml'
                        recordCoverage(
                            tools: [[
                                parser: 'JACOCO',
                                pattern: 'target/site/jacoco/jacoco.xml'
                            ]],
                            sourceCodeRetention: 'MODIFIED'
                        )
                        archiveArtifacts artifacts: 'target/site/jacoco/**', fingerprint: true
                        echo "JaCoCo HTML report archived in build artifacts"
                    }
                }
        
                stage('Package') {
                    steps {
                        echo 'packaging..'
                        sh 'mvn package'
                    }
                }

                 stage('Create and push docker image') {
                      steps {
                        sh script: 'cd  $WORKSPACE'
                        sh script: 'docker build --file Dockerfile --tag docker.io/kpashindla/orderbook:$BUILD_NUMBER .'
                        sh script: 'docker login -u $DOCKER_CREDS_USR -p $DOCKER_CREDS_PSW'
                        sh script: 'docker push docker.io/kpashindla/orderbook:$BUILD_NUMBER'
                      }
                 }

                  stage('deploy-QA') {
                             steps {
                                     sh script: 'cd  $WORKSPACE'
                                     sh script: 'ansible-playbook deploy-kube-with-monitoring.yml --extra-vars "env=qa build=$BUILD_NUMBER"'
                            }

                  }

    }
}
